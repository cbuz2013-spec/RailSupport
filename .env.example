DATABASE_URL=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Shared pilot is enabled only after schema setup and a successful auth test.
RAILSUPPORT_READY=false

# Comma-separated account IDs approved to create room pages; empty disables creation.
RAILSOCIAL_ROOM_CREATOR_IDS=

# Server-only email delivery. Configure the key as a Production Secret in Vercel.
RESEND_API_KEY=
RAILSOCIAL_EMAIL_FROM=Rail Social <noreply@phabfive.com>

# Web Push: generate one stable VAPID pair per environment. Keep the private key secret.
RAILSOCIAL_VAPID_PUBLIC_KEY=
RAILSOCIAL_VAPID_PRIVATE_KEY=
RAILSOCIAL_VAPID_SUBJECT=https://railsupport.vercel.app
# Authenticates the daily background retry job.
CRON_SECRET=
